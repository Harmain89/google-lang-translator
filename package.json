{
  "name": "lingodesk",
  "productName": "LingoDesk",
  "version": "1.0.0",
  "description": "Fast, minimalist desktop translation app powered by Google Translate",
  "author": "LingoDesk",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n vite,electron -c blue,green \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build:electron": "node build-electron.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron && electron-builder",
    "start": "npm run build:renderer && npm run build:electron && electron .",
    "pack": "npm run build:renderer && npm run build:electron && electron-builder --dir",
    "dist": "npm run build:renderer && npm run build:electron && electron-builder"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.lingodesk.app",
    "productName": "LingoDesk",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "resources/**"
    ],
    "mac": {
      "icon": "resources/icon.png"
    },
    "linux": {
      "icon": "resources/icon.png"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "LingoDesk-Setup.${ext}"
    },
    "portable": {
      "artifactName": "LingoDesk-Portable.${ext}"
    }
  }
}
